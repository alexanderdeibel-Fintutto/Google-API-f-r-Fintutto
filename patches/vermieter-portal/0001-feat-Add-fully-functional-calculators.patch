+const bundeslaender = [
+  { name: 'Baden-Württemberg', grunderwerbsteuer: 5.0 },
+  { name: 'Bayern', grunderwerbsteuer: 3.5 },
+  { name: 'Berlin', grunderwerbsteuer: 6.0 },
